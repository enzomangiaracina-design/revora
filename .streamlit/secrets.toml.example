# Modèle de .streamlit/secrets.toml — vraie connexion REVORA (phase 12.1)
#
# 1. Copier ce fichier en .streamlit/secrets.toml (exclu de Git : ne jamais le publier).
# 2. Remplir les valeurs (voir README › « Activer la vraie connexion »).
# 3. Relancer : streamlit run main.py
#
# Tant que cette section n'est pas complète, REVORA reste en mode prototype local
# (menu « Signed in as », sans mot de passe).

[auth]
# Adresse de retour après la connexion : l'URL de l'application + /oauth2callback.
# En local, le port doit être celui de l'application (8501 par défaut).
redirect_uri = "http://localhost:8501/oauth2callback"

# Secret aléatoire qui protège le cookie de connexion. Le générer avec :
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
cookie_secret = ""

# Identifiants de l'application OAuth créée chez le fournisseur (par vous, jamais par REVORA)
client_id = ""
client_secret = ""

# Google :
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
# Microsoft (Entra ID) : remplacer <tenant> par l'identifiant de votre organisation
# server_metadata_url = "https://login.microsoftonline.com/<tenant>/v2.0/.well-known/openid-configuration"
